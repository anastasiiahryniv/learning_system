<div class="d-flex justify-content-end">
  <div data-mdb-input-init class="form-outline mb-2">
    <%= search_form_for @q do |f| %>
      <div class="row">
        <div class="col-md-auto">
          <%= f.search_field :name_or_description_cont, placeholder: I18n.t('courses.search.search_placeholder'), class: 'form-control' %>
        </div>
        <div class="col">
          <%= f.submit I18n.t('courses.search.search'), class: 'btn btn-secondary' %>
          <%= link_to I18n.t('courses.search.clear_search'), request.path, class: 'cancel-button btn btn-secondary' %>
        </div>
      </div>
    <% end %>
  </div>
</div>
