<%= render 'courses/search_form.html.erb' %>

<div class="table-responsive">
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th scope="col"><%= sort_link(@q, :name, I18n.t('courses.index.course_name'), default_order: :asc) %> </th>
        <th scope="col"><%= sort_link(@q, :description, I18n.t('courses.index.description'), default_order: :asc) %>  </th>
        <th scope="col"><%= sort_link(@q, :status, I18n.t('courses.index.status'), default_order: :asc) %> </th>
        <th scope="col"><%= sort_link(@q, :students_count,  I18n.t('courses.index.students_count'), default_order: :asc) %> </th>
        <th scope="col"><%=I18n.t('courses.index.tags')%></th>
        <th scope="col"><%=I18n.t('courses.index.links')%></th>
      </tr>
    </thead>
    <tbody>
      <% @courses.each do |course| %>
        <tr>
          <td><%= course.truncated_name%></td>
          <td><%=course.truncated_description%></td>
          <td><%= course.status %></td>
          <td><%= course.students_count %></td>
          <td>
            <% course.tags.each do |tag| %>
              <%= link_to courses_path(tag: tag.name) do %>
                <span class="badge rounded-pill bg-light text-dark"><%= tag.name %></span>
              <% end %>
            <% end %>
          </td>
          <td>
            <% if current_instructor %>
              <%= link_to I18n.t('courses.index.show'), course %>
            <% end%>
            <% if policy(Course).update?  %>
              <%= link_to I18n.t('courses.index.update'), edit_course_path(course) %>
            <% end%>
            <% if policy(Course).destroy?  %>
              <%= link_to I18n.t('courses.index.destroy'), course, method: :delete, data: { confirm: I18n.t('courses.index.are_you_sure') } %>
            <% end%>
            <% if policy(Course).enroll? %>
              <%= link_to I18n.t('courses.index.enroll_in_course'), course_enrollments_path(course), method: :post, data: { confirm: I18n.t('courses.index.join_course') }%>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="pagination-container">
    <div class="d-flex justify-content-center">
      <%= paginate @courses.object, class: 'pagination-grey' %>
      <% if policy(Course).start? %>
        <%= link_to I18n.t('courses.index.download_list_of_courses'), courses_path(format: :csv) %>
      <% end %>
    </div>
  </div>
</div>
